{
  "name": "holojay",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm run dev -w @holojay/server\" \"npm run dev -w @holojay/client\"",
    "dev:web": "npm run dev -w @holojay/client",
    "build": "npm run build -w @holojay/client",
    "preview": "npm run build && npm run preview -w @holojay/client",
    "start:hub": "npm run start -w @holojay/server",
    "share": "node scripts/share-hub.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "localtunnel": "^2.0.2"
  }
}
